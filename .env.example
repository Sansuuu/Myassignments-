# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# For Vercel: Add this in Vercel Project Settings -> Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# For Vercel: Add your Vercel deployment URL (e.g. https://your-project.vercel.app)
APP_URL="MY_APP_URL"

# ADMIN_PASSKEY: Master passkey for emergency admin bootstrap
ADMIN_PASSKEY=

# Firebase Web Client Configuration (Vite Public Environment Variables)
# In Vercel, configure these under Project Settings -> Environment Variables
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
