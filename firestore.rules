rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == 'sanskargarg462@gmail.com')
      );
    }

    // Subjects collection (Readable by all students, writable by admin/init)
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if true;
    }

    // Assignments collection (Readable by all students, managed by admin/authorized users)
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Student Progress collection (Readable and writable for tracking coursework)
    match /studentProgress/{progressId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
